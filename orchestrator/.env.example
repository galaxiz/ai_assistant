# Orchestrator environment variables
# Copy to .env and fill in your values.

# --- Cognition Engine (gRPC) ---
ORCH__COGNITION_ENGINE__ADDRESS=http://localhost:50051
ORCH__COGNITION_ENGINE__CONNECT_TIMEOUT_SECS=5
ORCH__COGNITION_ENGINE__REQUEST_TIMEOUT_SECS=60
ORCH__COGNITION_ENGINE__MAX_RETRIES=3

# --- Qdrant ---
ORCH__QDRANT__URL=http://localhost:6334
# ORCH__QDRANT__API_KEY=your-api-key
ORCH__QDRANT__COLLECTION_PREFIX=agent

# --- HTTP server ---
ORCH__HTTP__HOST=0.0.0.0
ORCH__HTTP__PORT=8080

# --- Tool sandbox ---
ORCH__TOOLS__TOOLS_DIR=tools
ORCH__TOOLS__DEFAULT_TIMEOUT_SECS=10
ORCH__TOOLS__MAX_MEMORY_PAGES=256
ORCH__TOOLS__SANDBOX_ROOT=.

# --- Agent loop ---
ORCH__AGENT__MAX_TOOL_ITERATIONS=10
ORCH__AGENT__SESSION_IDLE_TIMEOUT_SECS=1800

# --- Observability ---
ORCH__TELEMETRY__LOG_LEVEL=info
ORCH__TELEMETRY__LOG_FORMAT=json   # json | console
ORCH__TELEMETRY__SERVICE_NAME=orchestrator
# ORCH__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317

# --- Auth (optional static token) ---
# ORCH__AUTH__TOKEN=your-secret-token
