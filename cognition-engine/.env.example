# Cognition Engine environment variables
# Copy this to .env and fill in the values.

# ---- gRPC server ----
CE_GRPC_HOST=0.0.0.0
CE_GRPC_PORT=50051

# ---- LLM models ----
CE_PRIMARY_MODEL=gemini/gemini-2.5-flash-preview-04-17
CE_FALLBACK_MODEL=gemini/gemini-2.0-flash

# ---- Token budget ----
CE_MAX_CONTEXT_TOKENS=1000000
CE_MAX_COMPLETION_TOKENS=8192

# ---- Retry / resilience ----
CE_LLM_MAX_RETRIES=3
CE_LLM_TIMEOUT_SECONDS=60.0

# ---- Logging ----
CE_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR | CRITICAL
CE_LOG_FORMAT=json        # json | console

# ---- API keys ----
# Required for Gemini models.
CE_GOOGLE_API_KEY=your-google-api-key-here

# ---- Timezone (for log timestamps) ----
# Set to your local timezone, e.g. America/Los_Angeles, America/New_York, Europe/London
TZ=UTC
