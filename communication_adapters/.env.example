# ── Core ──────────────────────────────────────────────────────────────────────
ORCHESTRATOR_URL=ws://localhost:8080/ws
ORCH_AUTH_TOKEN=                     # leave blank to disable auth header

SESSION_IDLE_TTL_MINUTES=30
LOG_LEVEL=info                       # trace | debug | info | warn | error

# ── Health endpoint ────────────────────────────────────────────────────────────
HEALTH_PORT=3000

# ── Telegram (leave TELEGRAM_ENABLED=false to skip) ────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Webhook mode: set TELEGRAM_WEBHOOK_URL to your public HTTPS domain.
# Omit (or leave blank) to use long-polling (recommended for local dev).
TELEGRAM_WEBHOOK_URL=
# Port Telegraf listens on for webhook requests. Telegram allows: 443, 80, 88, 8443.
TELEGRAM_WEBHOOK_PORT=8443

# ── Slack (leave SLACK_ENABLED=false to skip) ──────────────────────────────────
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Socket Mode (dev, no public URL): set SLACK_APP_TOKEN.
# HTTP mode (prod): leave SLACK_APP_TOKEN blank and set SLACK_PORT.
SLACK_APP_TOKEN=
SLACK_PORT=3001
